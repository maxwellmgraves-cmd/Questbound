rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsFamily(familyId) {
      return request.auth != null && request.auth.uid == familyId;
    }

    match /families/{familyId} {
      allow read, write: if ownsFamily(familyId);

      match /{document=**} {
        allow read, write: if ownsFamily(familyId);
      }
    }
  }
}
